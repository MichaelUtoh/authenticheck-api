# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
API_DOCS_ENABLED=true

DATABASE_URL=postgres://authenticheck:authenticheck@localhost:5432/authenticheck
REDIS_URL=redis://localhost:6379/0

# Frontend (Next.js) origin(s) allowed for CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# --- Product image storage -----------------------------------------------------------------
# Local development (default): leave MEDIA_BUCKET unset. Images are written to ./media and served
# by the dev server. MEDIA_URL must be absolute if the frontend runs on another origin.
MEDIA_URL=http://localhost:8000/media/

# Production: store images in S3 or any S3-compatible store (Cloudflare R2, MinIO).
# Uncomment ALL of the variables in ONE of the two blocks below. Setting MEDIA_BUCKET switches
# storage from local disk to the bucket, so do not enable it with placeholder values.
# Keep the bucket private and serve it through a CDN. Needs django-storages (in requirements).

# Option A: AWS S3 behind CloudFront
#MEDIA_BUCKET=authenticheck-media-prod
#MEDIA_REGION=eu-west-1
#MEDIA_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
#MEDIA_SECRET_ACCESS_KEY=replace-with-the-iam-user-secret-key
#MEDIA_CDN_DOMAIN=media.example.com

# Option B: Cloudflare R2 (or MinIO) behind a custom domain
#MEDIA_BUCKET=authenticheck-media-prod
#MEDIA_ENDPOINT_URL=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
#MEDIA_ACCESS_KEY_ID=replace-with-the-r2-access-key-id
#MEDIA_SECRET_ACCESS_KEY=replace-with-the-r2-secret-access-key
#MEDIA_CDN_DOMAIN=media.example.com

# Uploads that no product references are deleted after this many hours.
# Requires the Celery beat process to be running.
#UNATTACHED_IMAGE_TTL_HOURS=24
